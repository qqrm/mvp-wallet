# Dev-focused container for the Rust API.
# Uses bind-mounts in docker-compose, so it does not COPY the source tree.
FROM rust:stable-slim-bookworm

RUN apt-get update   && apt-get install -y --no-install-recommends      ca-certificates pkg-config libsqlite3-dev   && rm -rf /var/lib/apt/lists/*

WORKDIR /repo/wallet-backend

# Compile dependencies faster by keeping cargo registry in a named volume.
ENV CARGO_TERM_COLOR=always

CMD ["bash", "-lc", "cargo run -p wallet-api"]
