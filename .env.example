# --- API (wallet-backend) ---
ADMIN_TOKEN=admin-dev-token
USER_TOKEN_SECRET=dev-secret

# bind address for docker (container)
BIND_ADDR=0.0.0.0:3000

# SQLite file location inside docker container
DB_FILE=/data/wallet.db

# optional logging
RUST_LOG=info

# --- Web (wallet-web) ---
# API base URL. Keep empty for Vite proxy (recommended).
VITE_API_BASE=
